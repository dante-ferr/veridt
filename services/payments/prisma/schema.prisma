generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CreditPackage {
  id                  String  @id
  code                String  @unique
  name                String
  creditCount         Int     @map("credit_count")
  pricePerCreditCents Int     @map("price_per_credit_cents")
  description         String
  active              Boolean @default(true)

  @@map("credit_packages")
}

model CreditOrder {
  id                  String   @id
  accountId           String   @map("account_id")
  packageId           String   @map("package_id")
  packageName         String   @map("package_name")
  creditCount         Int      @map("credit_count")
  pricePerCreditCents Int      @map("price_per_credit_cents")
  totalCents          Int      @map("total_cents")
  state               String
  billing             Json
  createdAt           DateTime @map("created_at")

  @@index([accountId, createdAt])
  @@map("credit_orders")
}
